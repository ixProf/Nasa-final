# Browser-facing URLs. Leave relative for Vite/nginx same-origin proxying.
VITE_API_BASE_URL=/api
VITE_HUB_BASE_URL=/hubs
# Vite proxy target, read from Frontend/.env.development.local (server only).
VITE_BACKEND_URL=http://localhost:5256
# When deploying static files without a reverse proxy, instead set:
# VITE_API_BASE_URL=https://astrohealth.runasp.net/api
# VITE_HUB_BASE_URL=https://astrohealth.runasp.net/hubs
# Add the deployed frontend origin to the backend Cors:AllowedOrigins.

# Optional BioDigital anatomy. Use the Viewer developer key, NEVER a developer secret.
# Register localhost and the Vercel domain with BioDigital; use a model your plan licenses.
# Empty values keep the existing local 3D/2D body map fully available.
VITE_BIODIGITAL_DEVELOPER_KEY=
VITE_BIODIGITAL_MODEL_ID=
# Optional exact object IDs from the chosen model (JSON, keyed by body region).
# VITE_BIODIGITAL_REGION_OBJECTS={"brain":["your-object-id"],"heart":[],"lungs":[],"eyes":[],"stomach":[]}
