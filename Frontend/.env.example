# Browser-facing URLs. Leave relative for Vite/nginx same-origin proxying.
VITE_API_BASE_URL=/api
VITE_HUB_BASE_URL=/hubs
# Vite proxy target, read from Frontend/.env.development.local (server only).
VITE_BACKEND_URL=http://localhost:5256
# When deploying static files without a reverse proxy, instead set:
# VITE_API_BASE_URL=https://astrohealth.runasp.net/api
# VITE_HUB_BASE_URL=https://astrohealth.runasp.net/hubs
# Add the deployed frontend origin to the backend Cors:AllowedOrigins.
